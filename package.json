{
  "name": "analytics-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "railway:start": "npm run db:migrate && npm run start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed:game": "tsx scripts/seed-game.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "geoip-lite": "^2.0.2",
    "hono": "^4.6.16",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^22.10.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "esbuild": "^0.25.3"
  }
}
